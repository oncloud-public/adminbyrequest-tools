{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "5623102500726087117"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "abr-approvals",
      "maxLength": 14,
      "metadata": {
        "description": "Short name used in resource names."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region. Default: the resource group region."
      }
    },
    "packageUrl": {
      "type": "string",
      "defaultValue": "https://github.com/oncloud-public/adminbyrequest-tools/releases/download/teams-approvals-v0.1.0/abr-approvals-bot.zip",
      "metadata": {
        "description": "URL of the app package (zip with code and dependencies). Default: release v0.1.0 on GitHub. The app fetches it at every restart."
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "S1",
        "P0v3"
      ],
      "metadata": {
        "description": "App Service plan size. B1 is enough for hundreds of customers."
      }
    }
  },
  "variables": {
    "suffix": "[substring(uniqueString(resourceGroup().id), 0, 6)]",
    "appName": "[format('{0}-{1}', parameters('namePrefix'), variables('suffix'))]",
    "storageName": "[format('stabr{0}{1}', variables('suffix'), substring(uniqueString(subscription().id, resourceGroup().id), 0, 6))]",
    "vaultName": "[format('kv-abr-{0}', variables('suffix'))]",
    "tags": {
      "app": "abr-approvals"
    },
    "tenantId": "[subscription().tenantId]",
    "roles": {
      "kvSecretsOfficer": "b86a8fe4-44ce-4948-aee5-eccb2c155cd7",
      "tableDataContributor": "0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3"
    }
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('id-{0}', variables('appName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/tableServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "copy": {
        "name": "tables",
        "count": "[length(createArray('botcustomers', 'botchannels', 'botposted', 'botdecisions'))]"
      },
      "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageName'), 'default', createArray('botcustomers', 'botchannels', 'botposted', 'botdecisions')[copyIndex()])]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/tableServices', variables('storageName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('vaultName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "tenantId": "[variables('tenantId')]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), variables('roles').kvSecretsOfficer)]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles').kvSecretsOfficer)]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName')))]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), variables('roles').tableDataContributor)]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles').tableDataContributor)]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName')))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[format('asp-{0}', variables('appName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('sku')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "app,linux",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('asp-{0}', variables('appName')))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "NODE|22-lts",
          "appCommandLine": "npm start",
          "alwaysOn": true,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "healthCheckPath": "/health",
          "appSettings": [
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "[parameters('packageUrl')]"
            },
            {
              "name": "CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE",
              "value": "UserManagedIdentity"
            },
            {
              "name": "CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), '2023-01-31').clientId]"
            },
            {
              "name": "CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID",
              "value": "[variables('tenantId')]"
            },
            {
              "name": "AZURE_CLIENT_ID",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), '2023-01-31').clientId]"
            },
            {
              "name": "TENANT_ID",
              "value": "[variables('tenantId')]"
            },
            {
              "name": "KEY_VAULT_NAME",
              "value": "[variables('vaultName')]"
            },
            {
              "name": "STORAGE_ACCOUNT",
              "value": "[variables('storageName')]"
            },
            {
              "name": "TEAMS_APP_ID",
              "value": "[guid(resourceGroup().id, 'abr-approvals-teams-app')]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName')))]",
        "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), variables('roles').kvSecretsOfficer))]",
        "[resourceId('Microsoft.Web/serverfarms', format('asp-{0}', variables('appName')))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
        "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), variables('roles').tableDataContributor))]",
        "tables",
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    },
    {
      "type": "Microsoft.BotService/botServices",
      "apiVersion": "2022-09-15",
      "name": "[format('bot-{0}', variables('appName'))]",
      "location": "global",
      "tags": "[variables('tags')]",
      "kind": "azurebot",
      "sku": {
        "name": "F0"
      },
      "properties": {
        "displayName": "ABR Approvals by OnCloud",
        "endpoint": "[format('https://{0}/api/messages', reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01').defaultHostName)]",
        "msaAppType": "UserAssignedMSI",
        "msaAppId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), '2023-01-31').clientId]",
        "msaAppTenantId": "[variables('tenantId')]",
        "msaAppMSIResourceId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName')))]",
        "[resourceId('Microsoft.Web/sites', variables('appName'))]"
      ]
    },
    {
      "type": "Microsoft.BotService/botServices/channels",
      "apiVersion": "2022-09-15",
      "name": "[format('{0}/{1}', format('bot-{0}', variables('appName')), 'MsTeamsChannel')]",
      "location": "global",
      "properties": {
        "channelName": "MsTeamsChannel",
        "properties": {
          "isEnabled": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.BotService/botServices', format('bot-{0}', variables('appName')))]"
      ]
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01').defaultHostName)]"
    },
    "resourceGroup": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "nextStep": {
      "type": "string",
      "value": "[format('In Azure Cloud Shell (Bash) run: curl -sL https://raw.githubusercontent.com/oncloud-public/adminbyrequest-tools/main/ABR-Teams-Approvals/infra/setup-entra.sh | bash -s -- {0}', resourceGroup().name)]"
    }
  }
}